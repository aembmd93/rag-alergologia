# ── Google AI Studio ───────────────────────────────────────────────────────────
# Obtén tu clave en https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# ── Pinecone ───────────────────────────────────────────────────────────────────
# Obtén tu clave en https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Nombre del índice (se crea automáticamente en la primera ingesta)
PINECONE_INDEX_NAME=rag-alergologia

# Región del índice serverless (ej: us-east-1, eu-west-1, us-west-2)
PINECONE_ENVIRONMENT=us-east-1

# ── Autenticación ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_password_here
